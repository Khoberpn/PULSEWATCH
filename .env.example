# PULSEWATCH Environment Configuration

# Database Configuration (PostgreSQL in production/Docker, or SQLite for local zero-config dev)
# For local dev without Docker:
DATABASE_URL=sqlite+aiosqlite:///./pulsewatch.db
# For Docker / PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch

POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch_secret
POSTGRES_DB=pulsewatch

# Application Environment
ENVIRONMENT=development
DEBUG=false

# Security & SSRF Protection
# Set to 'false' in production. When false, blocks private networks, loopback (127.0.0.1), and cloud metadata (169.254.169.254).
ALLOW_LOCAL_TARGETS=false
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5

# Monitoring Defaults
DEFAULT_CHECK_INTERVAL=60
DEFAULT_TIMEOUT=10
DEFAULT_DEGRADED_THRESHOLD_MS=1000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
